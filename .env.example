# --- Phase 1 (required) ---
SENTRY_MCP_URL=https://mcp.sentry.dev/mcp
SENTRY_OAUTH_CLIENT_NAME=BugOps
SENTRY_OAUTH_REDIRECT_URI=http://localhost:3030/callback
SENTRY_TOKEN_CACHE_PATH=data/sentry_oauth_tokens.json

GITHUB_TOKEN=
GITHUB_REPO_MAP_JSON={"backend-api":"myorg/backend-api","web-app":"myorg/web-app"}

GIT_CACHE_DIR=data/repo_cache
MAX_CONTEXT_FRAMES=15

# --- Phase 2 (required) ---
# LLM_PROVIDER selects which langchain integration package init_chat_model resolves to
# (e.g. "anthropic", "openai") — switching models/providers is just editing these lines.
# Example below targets Kimi (moonshotai/kimi-k2.7-code) via Alibaba Model Studio's
# OpenAI-compatible endpoint — any OpenAI-compatible provider works the same way, just
# "openai" as the provider + that provider's base_url.
LLM_PROVIDER=openai
LLM_MODEL=kimi-k2.7-code
LLM_API_KEY=
LLM_BASE_URL=https://llm-jl4320mnk7eiyu7j.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
MAX_INVESTIGATE_ROUNDS=4

# --- Later phases (leave blank until their phase introduces the code that reads them) ---
# SENTRY_WEBHOOK_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_DEFAULT_CHANNEL=
# CHECKPOINT_DB_PATH=data/bugops_checkpoints.sqlite
# DEDUPE_DB_PATH=data/bugops_dedupe.sqlite
# MIN_SEVERITY=error
# DEDUPE_COOLDOWN_MINUTES=60
# MAX_FIX_RETRIES=3
