# --- Phase 1 (required) ---
SENTRY_MCP_URL=https://mcp.sentry.dev/mcp
SENTRY_OAUTH_CLIENT_NAME=BugOps
SENTRY_OAUTH_REDIRECT_URI=http://localhost:3030/callback
SENTRY_TOKEN_CACHE_PATH=data/sentry_oauth_tokens.json

GITHUB_TOKEN=
GITHUB_REPO_MAP_JSON={"backend-api":"myorg/backend-api","web-app":"myorg/web-app"}

GIT_CACHE_DIR=data/repo_cache
MAX_CONTEXT_FRAMES=15

# --- Phase 2 (required) ---
# LLM_PROVIDER selects which langchain integration package init_chat_model resolves to
# (e.g. "anthropic", "openai") — switching models/providers is just editing these lines.
# Example below targets Kimi (moonshotai/kimi-k2.7-code) via Alibaba Model Studio's
# OpenAI-compatible endpoint — any OpenAI-compatible provider works the same way, just
# "openai" as the provider + that provider's base_url.
LLM_PROVIDER=openai
LLM_MODEL=kimi-k2.7-code
LLM_API_KEY=
LLM_BASE_URL=https://llm-jl4320mnk7eiyu7j.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
MAX_INVESTIGATE_ROUNDS=4

# --- Phase 3 (required) ---
# generate_fix reuses MAX_INVESTIGATE_ROUNDS above for its own tool-use loop.
MAX_FIX_RETRIES=3
DOCKER_IMAGE=node:20-bookworm-slim
# Optional override of the auto-detected install/test command, keyed by "owner/name".
REPO_TEST_CMD_MAP_JSON={}
SANDBOX_WORKTREE_DIR=data/repo_worktrees
SANDBOX_INSTALL_TIMEOUT_S=300
SANDBOX_TEST_TIMEOUT_S=300
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2
# Set to false to skip test_fix entirely (e.g. on a machine without Docker).
ENABLE_SANDBOX_TESTS=true

# --- Phase 4 (optional — leave SLACK_BOT_TOKEN blank to skip Slack notifications) ---
# Minimum decision_gate confidence for route_decision to ever be "suggest_pr".
DECISION_CONFIDENCE_FLOOR=0.75
# A diff touching more files than this is never "low" risk, regardless of confidence.
DECISION_MAX_FILES_FOR_LOW_RISK=2
# Set to false to skip the Slack API call entirely (e.g. no Slack workspace configured).
ENABLE_SLACK_NOTIFY=true
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# --- Phase 5 (optional) ---
# open_pr pushes a branch and opens a draft PR when route_decision is "suggest_pr", after an
# interactive approval prompt (run_pipeline.py's --yes flag, or PR_AUTO_APPROVE below, skips it).
# GITHUB_TOKEN above needs write access (repo scope, or Contents + Pull requests) for this to work.
ENABLE_PR_CREATION=true
PR_DRAFT=true
PR_BRANCH_PREFIX=bugops/
PR_AUTO_APPROVE=false

# --- Phase 6 (optional) ---
# Tracks each opened PR's risk_category and eventual fate (merged/closed); once a risk_category
# clears both thresholds below, open_pr skips the manual approval prompt for future PRs in it.
PR_OUTCOME_STORE_PATH=data/pr_outcomes.json
RELIABILITY_MIN_SAMPLE_SIZE=8
RELIABILITY_MERGE_RATE_THRESHOLD=0.85
# Set to false to keep the Phase 5 manual gate always on (reliability never auto-approves).
ENABLE_RELIABILITY_AUTO_APPROVE=true

# --- Later phases (leave blank until their phase introduces the code that reads them) ---
# SENTRY_WEBHOOK_SECRET=
# CHECKPOINT_DB_PATH=data/bugops_checkpoints.sqlite
# DEDUPE_DB_PATH=data/bugops_dedupe.sqlite
# MIN_SEVERITY=error
# DEDUPE_COOLDOWN_MINUTES=60
